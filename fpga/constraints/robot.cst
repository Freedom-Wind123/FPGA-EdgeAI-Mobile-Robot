IO_PORT "ros_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "ros_uart_tx" M15;
IO_PORT "ros_uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;

// P7 / GPIO0 header assignments. VCCIO must remain at the factory 3.3 V setting.
IO_LOC  "motor_a_pwm" A13; // P7-1  GPIO0_0
IO_LOC  "motor_b_pwm" A14; // P7-2  GPIO0_1
IO_LOC  "motor_c_pwm" A15; // P7-3  GPIO0_2
IO_LOC  "motor_d_pwm" A16; // P7-4  GPIO0_3
IO_LOC  "motor_a_in1" A18; // P7-5  GPIO0_4
IO_LOC  "motor_a_in2" A19; // P7-6  GPIO0_5
IO_LOC  "motor_b_in1" F13; // P7-7  GPIO0_6
IO_LOC  "motor_b_in2" F14; // P7-8  GPIO0_7
IO_LOC  "motor_c_in1" E13; // P7-9  GPIO0_8
IO_LOC  "motor_c_in2" E14; // P7-10 GPIO0_9
IO_LOC  "motor_d_in1" C13; // P7-13 GPIO0_10
IO_LOC  "motor_d_in2" B13; // P7-14 GPIO0_11

IO_LOC  "enc_a_phase_a" D14; // P7-15 GPIO0_12
IO_LOC  "enc_a_phase_b" D15; // P7-16 GPIO0_13
IO_LOC  "enc_b_phase_a" C14; // P7-17 GPIO0_14
IO_LOC  "enc_b_phase_b" C15; // P7-18 GPIO0_15
IO_LOC  "enc_c_phase_a" B15; // P7-19 GPIO0_16
IO_LOC  "enc_c_phase_b" B16; // P7-20 GPIO0_17
IO_LOC  "enc_d_phase_a" D17; // P7-21 GPIO0_18
IO_LOC  "enc_d_phase_b" C17; // P7-22 GPIO0_19

IO_LOC  "imu_uart_rx" E16; // P7-23 GPIO0_20, connect WT901 TX
IO_LOC  "imu_uart_tx" D16; // P7-24 GPIO0_21, connect WT901 RX
// Board-key edition: P7-25 external key is unused.
IO_LOC "key_mode_n" A20; // S1, active low
IO_LOC "key_stop_n" F15; // S0, active low
IO_LOC "led[0]" M22;
IO_LOC "led[1]" N22;
